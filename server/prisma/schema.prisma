generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  LAPTOP
  GEAR
  COMPONENT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  COD
}

model Product {
  id          Int         @id @default(autoincrement())
  sku         String      @unique
  name        String
  brand       String
  description String?
  type        ProductType
  price       Decimal     @db.Decimal(12, 2)
  stock       Int
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([type])
  @@index([brand])
}

model User {
  id          Int      @id @default(autoincrement())
  username    String?
  email       String   @unique
  password    String
  role        String   @default("USER")
  firstName   String
  lastName    String
  gender      String?
  address     String?
  dateOfBirth DateTime?
  phone       String?
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Employee {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String?
  address   String?
  role      String?
  salary    Decimal? @db.Decimal(12, 2)
  hireDate  DateTime?
  payments  Payment[]
}

model Order {
  id          Int        @id @default(autoincrement())
  userId      Int
  status      OrderStatus @default(PENDING)
  orderDate   DateTime   @default(now())
  netAmount   Decimal    @db.Decimal(12, 2) @default(0)
  tax         Decimal    @db.Decimal(12, 2) @default(0)
  totalAmount Decimal    @db.Decimal(12, 2) @default(0)
  createdAt   DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  payment    Payment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id         Int          @id @default(autoincrement())
  orderId    Int          @unique
  employeeId Int?
  amount     Decimal      @db.Decimal(12, 2)
  method     PaymentMethod
  status     PaymentStatus
  paidAt     DateTime?
  createdAt  DateTime     @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([status])
}
